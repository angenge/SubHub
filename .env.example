# SubHub deployment settings.
#
# Copy this file to `.env` and adjust the values:
#     cp .env.example .env
#
# `.env` is git-ignored, so your local customisations never conflict with
# "git pull". All values below are optional; the defaults in docker-compose.yml
# apply when a variable is unset.

# ---- Network -------------------------------------------------------------
# Interface to bind on the host.
#   0.0.0.0   -> reachable from the network (only safe with a firewall)
#   127.0.0.1 -> local only, use this when a reverse proxy (Nginx/Caddy/
#                Cloudflare Tunnel) sits in front of SubHub
SUBHUB_BIND=0.0.0.0

# Host port mapped to the container's port 3000.
SUBHUB_PORT=3000

# Set to true when running behind a reverse proxy or CDN, otherwise every
# request appears to come from the proxy IP and rate limiting lumps all
# clients together. Accepted values: true / false
TRUST_PROXY=false

# ---- Data ----------------------------------------------------------------
# Host directory mounted as /app/data (contains subhub.db and backups/).
# Strongly recommended: keep it OUTSIDE the git working tree, e.g.
#   SUBHUB_DATA_DIR=/home/deploy/muse-workspace/data/subhub
SUBHUB_DATA_DIR=./data

# ---- Build metadata ------------------------------------------------------
# Written by scripts/deploy.sh automatically; build is reported by GET /health.
# SUBHUB_BUILD_ID=dev
