{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "allowImportingTsExtensions": false
  },
  "include": ["src/server/**/*", "src/core/**/*"],
  "exclude": ["src/core/__tests__"]
}
